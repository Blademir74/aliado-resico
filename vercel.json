{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 30,
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api|styles.css|js).*)",
      "destination": "/index.html"
    }
  ]
}